#!/bin/sh /etc/rc.common
USE_PROCD=1
START=21
STOP=10
start_service() {
    procd_open_instance
    procd_set_param command /usr/sbin/dnsmasq --keep-in-foreground --conf-file=/etc/privacy-register-dns.conf --pid-file=/var/run/privacy-register-dns.pid
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
