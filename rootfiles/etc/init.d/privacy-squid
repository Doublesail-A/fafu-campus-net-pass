#!/bin/sh /etc/rc.common
USE_PROCD=1
START=100
STOP=10
start_service() {
    /usr/sbin/squid -k parse -f /etc/squid/squid.conf >/tmp/privacy-squid-parse.log 2>&1 || return 1
    procd_open_instance
    procd_set_param command /usr/sbin/squid --foreground -f /etc/squid/squid.conf
    procd_set_param respawn
    procd_set_param limits nofile='4096 4096'
    procd_close_instance
}
