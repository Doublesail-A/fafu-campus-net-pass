#!/bin/sh /etc/rc.common
START=101
STOP=10
start() {
    wan="$(uci -q get privacy_stack.main.wan_device)"
    case "$wan" in ''|*[!a-zA-Z0-9_.:-]*)return 1;;esac
    nft list table inet UA3F >/dev/null 2>&1 || /etc/init.d/ua3f start
    for i in 1 2 3 4 5;do nft list chain inet UA3F PREROUTING >/dev/null 2>&1 && break;sleep 1;done
    nft list chain inet UA3F PREROUTING >/dev/null 2>&1 || return 1
    if ! nft list chain inet UA3F PREROUTING | grep -q fafu_local_relay;then
        nft insert rule inet UA3F PREROUTING fib daddr type local return comment fafu_local_relay
    fi
    if ! nft list chain inet UA3F privacy_output >/dev/null 2>&1;then
        nft -f - <<EOF
add chain inet UA3F privacy_output { type nat hook output priority -120; policy accept; }
add rule inet UA3F privacy_output meta mark 201 return
add rule inet UA3F privacy_output fib daddr type local return
add rule inet UA3F privacy_output oifname "$wan" tcp dport != { 22, 53 } redirect to :1080
EOF
    fi
    # These apply to both forwarded and locally reconstructed WAN traffic.
    mtu="$(cat "/sys/class/net/$wan/mtu")";mss="$((mtu-40))"
    case "$mss" in ''|*[!0-9]*)return 1;;esac
    batch="$(mktemp /tmp/privacy-wire.XXXXXX)" || return 1
    nft list table inet privacy_wire_profile >/dev/null 2>&1 && echo 'delete table inet privacy_wire_profile' > "$batch" || : > "$batch"
    cat >> "$batch" <<EOF
table inet privacy_wire_profile {
 chain post {
  type filter hook postrouting priority -140; policy accept;
  oifname "$wan" ip ttl set 128
  oifname "$wan" ip frag-off & 0x3fff == 0 ip id set (numgen random mod 65536 << 16)
  oifname "$wan" tcp option timestamp exists reset tcp option timestamp
  oifname "$wan" tcp flags & (syn | ack) == syn tcp window set 65535
  oifname "$wan" tcp flags & (syn | rst) == syn tcp option maxseg size > $mss tcp option maxseg size set $mss
 }
 chain discovery {
  type filter hook prerouting priority -311; policy accept;
  iifname "br-lan" fib daddr oifname "$wan" ip daddr { 224.0.0.0/4, 255.255.255.255 } drop
  iifname "br-lan" fib daddr oifname "$wan" udp dport { 67, 68, 137, 138, 1900, 3702, 5353, 5355 } drop
  iifname "br-lan" fib daddr oifname "$wan" tcp dport { 139, 445 } drop
 }
}
EOF
    nft -f "$batch";code=$?;rm -f "$batch";return "$code"
}
